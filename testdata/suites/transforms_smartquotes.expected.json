   "html4": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xml:lang=\"en\" lang=\"en\">\n<head>\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\" />\n<meta name=\"generator\" content=\"Docutils 0.23: https://docutils.sourceforge.io/\" />\n<title>&lt;stdin&gt;</title>\n\n</head>\n<body>\n<div class=\"document\">\n\n\n<p lang=\"de\">German &quot;smart quotes&quot; and 'secondary smart quotes'.</p>\n<p lang=\"en-uk-x-altquot\">British &quot;primary quotes&quot; use single and\n'secondary quotes' double quote signs.</p>\n<p lang=\"foo\">&quot;Quoting style&quot; for unknown languages is 'ASCII'.</p>\n<p lang=\"de-x-altquot\">Alternative German &quot;smart quotes&quot; and 'secondary smart quotes'.</p>\n</div>\n</body>\n</html>\n",
