   "pxml": "<document source=\"<stdin>\">\n    <paragraph>\n        Docutils escape mechanism uses the backslash:\n    <paragraph>\n        Remove non-escaped backslashes:\n        item newline tab \" ' *.\n    <paragraph>\n        Remove-escaped-whitespace-including-newlines.\n    <paragraph>\n        \\Keep\\escaped\\backslashes\\\n        (but\\only\\one).\n    <paragraph>\n        \\ Keep \\ space\\ around  \\ backslashes.\n    <paragraph>\n        Keep backslashes \n        <literal>\n            \\in\\ literal\n        , \n        <math>\n            in \\mathrm{math}\n        ,\n        and \n        <literal classes=\"code\">\n            in\\ code\n        .\n    <paragraph>\n        Test around inline elements:\n        <footnote_reference auto=\"*\" ids=\"footnote-reference-1\" refid=\"footnote-1\">\n            *\n    <paragraph>\n        <emphasis>\n            emphasized\n        , H\n        <subscript>\n            2\n        O and \n        <math>\n            x^2\n    <section ids=\"emphasized-h2o-and-x-2\" names=\"emphasized,\\ h2o\\ and\\ x^2\">\n        <title>\n            <emphasis>\n                emphasized\n            , H\n            <subscript>\n                2\n            O and \n            <math>\n                x^2\n        <footnote auto=\"*\" backrefs=\"footnote-reference-1\" ids=\"footnote-1\">\n            <label>\n                *\n            <paragraph>\n                and footnotes\n",
