   "pxml": "<document source=\"<stdin>\">\n    <paragraph>\n        Quotes and inline-elements:\n    <bullet_list bullet=\"*\">\n        <list_item>\n            <paragraph>\n                Around \"\n                <target ids=\"targets\" names=\"targets\">\n                    targets\n                \", \"\n                <emphasis>\n                    emphasized\n                \" or \"\n                <literal>\n                    literal\n                \" text\n                and links to \"\n                <reference name=\"targets\" refid=\"targets\">\n                    targets\n                \".\n        <list_item>\n            <paragraph>\n                Inside \n                <emphasis>\n                    \"emphasized\"\n                 or other \n                <title_reference>\n                    inline \"roles\"\n    <paragraph>\n        Do not drop characters from intra-word inline markup like\n        <emphasis>\n            re\n        <literal>\n            Structured\n        <emphasis>\n            Text\n        .\n",
