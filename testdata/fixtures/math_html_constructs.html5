<main id="math-as-html-math2html">
<h1 class="title">Math as HTML (math2html)</h1>

<p>Inline: <math xmlns="http://www.w3.org/1998/Math/MathML">
  <msup>
    <mi>x</mi>
    <mn>2</mn>
  </msup>
  <mo>+</mo>
  <msub>
    <mi>y</mi>
    <mn>1</mn>
  </msub>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <msubsup>
    <mi>a</mi>
    <mi>i</mi>
    <mi>j</mi>
  </msubsup>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <msubsup>
    <mi>x</mi>
    <mrow>
      <mi>k</mi>
      <mo>+</mo>
      <mn>1</mn>
    </mrow>
    <mrow>
      <mn>2</mn>
      <mi>n</mi>
    </mrow>
  </msubsup>
</math>,
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mfrac>
    <mi>a</mi>
    <mi>b</mi>
  </mfrac>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <mroot>
    <mi>x</mi>
    <mn>3</mn>
  </mroot>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <munderover>
    <mo movablelimits="true">∑</mo>
    <mrow>
      <mi>i</mi>
      <mo>=</mo>
      <mn>1</mn>
    </mrow>
    <mi>n</mi>
  </munderover>
  <mi>i</mi>
</math>,
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi>α</mi>
  <mi>β</mi>
  <mi class="capital-greek">Γ</mi>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi mathvariant="normal">d</mi>
  <mi>x</mi>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <mn>2</mn>
  <mi mathvariant="normal">m</mi>
</math>,
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mover accent="true">
    <mi>x</mi>
    <mo stretchy="false">ˆ</mo>
  </mover>
  <mover accent="true">
    <mrow>
      <mi>a</mi>
      <mi>b</mi>
    </mrow>
    <mo stretchy="false">ˉ</mo>
  </mover>
  <mover accent="true">
    <mi>v</mi>
    <mo stretchy="false" scriptlevel="+1">→</mo>
  </mover>
  <mo>≠</mo>
  <mo>∉</mo>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi>a</mi>
  <mo>≤</mo>
  <mi>b</mi>
  <mo>≠</mo>
  <mi>c</mi>
</math>,
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi>f</mi>
  <mo stretchy="false">(</mo>
  <mi>x</mi>
  <mo stretchy="false">)</mo>
  <mo>=</mo>
  <mi>sin</mi>
  <mo>&ApplyFunction;</mo>
  <mi>x</mi>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <mtext>some text</mtext>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <msup>
    <mi>ℝ</mi>
    <mi>n</mi>
  </msup>
</math>,
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mo>(</mo>
    <mfrac>
      <mi>a</mi>
      <mi>b</mi>
    </mfrac>
    <mo>)</mo>
  </mrow>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow class="binom">
    <mo>(</mo>
    <mfrac linethickness="0">
      <mi>n</mi>
      <mi>k</mi>
    </mfrac>
    <mo>)</mo>
  </mrow>
</math>,
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi>a</mi>
  <mspace width="0.1667em"></mspace>
  <mi>b</mi>
  <mspace width="0.2778em"></mspace>
  <mi>c</mi>
  <mspace width="1em"></mspace>
  <mi>d</mi>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi>x</mi>
  <mo>'</mo>
  <mo>&lt;</mo>
  <mi>y</mi>
  <mo>&gt;</mo>
  <mi>z</mi>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <mn>100</mn>
  <mi>%</mi>
</math>,
<span class="math problematic">\upalpha</span>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <mover accent="false">
    <mrow>
      <mi>x</mi>
      <mo>+</mo>
      <mi>y</mi>
    </mrow>
    <mo accent="true">_</mo>
  </mover>
</math>, <math xmlns="http://www.w3.org/1998/Math/MathML">
  <munder>
    <mrow>
      <mi>a</mi>
      <mo>+</mo>
      <mi>b</mi>
    </mrow>
    <mo>⏟</mo>
  </munder>
</math>.</p>
