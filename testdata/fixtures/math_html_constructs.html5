<p>Cases:</p>
<div>
<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mi>f</mi>
  <mo stretchy="false">(</mo>
  <mi>x</mi>
  <mo stretchy="false">)</mo>
  <mo>=</mo>
  <mrow>
    <mo rspace="0.17em">{</mo>
    <mtable columnalign="left" class="cases">
      <mtr>
        <mtd>
          <mn>1</mn>
        </mtd>
        <mtd>
          <mi>x</mi>
          <mo>&gt;</mo>
          <mn>0</mn>
        </mtd>
      </mtr>
      <mtr>
        <mtd>
          <mn>0</mn>
        </mtd>
        <mtd>
          <mtext>otherwise</mtext>
        </mtd>
      </mtr>
    </mtable>
  </mrow>
</math>
</div>
<p>Aligned environments:</p>
<div>
<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mtable class="ams-align" displaystyle="true">
    <mtr>
      <mtd>
        <mi>a</mi>
      </mtd>
      <mtd>
        <mo>=</mo>
        <mi>b</mi>
        <mo>+</mo>
        <mi>c</mi>
      </mtd>
    </mtr>
    <mtr>
      <mtd></mtd>
      <mtd>
        <mo>=</mo>
        <mi>d</mi>
      </mtd>
    </mtr>
  </mtable>
</math>
</div>
<pre class="math problematic">
\begin{align*} a &amp;= b \\ c &amp;= d \end{align*}
</pre>
